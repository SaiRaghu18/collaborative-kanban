# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
# In Supabase Dashboard: Go to Project Settings (⚙️) -> Database -> Connection string -> URI
#
# 1. DATABASE_URL: Use the Transaction Pooler (Port 6543) for application queries & Prisma Client.
#    Add "?pgbouncer=true" at the end.
#    Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Use the Direct connection (Port 5432) for Prisma CLI migrations & schema push.
#    Format: postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ⚠️ URL ENCODING TIP:
# If your password contains special characters (like @, #, $, %, !), encode them:
# "@" -> "%40"  (Example: "12@pass" becomes "12%40pass")
# "#" -> "%23"
# "$" -> "%24"

# ─────────────────────────────────────────────────────────────────────────────
# JWT CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET="dev_secret_key_change_in_production_min_64_characters_kanban_flow_secure_token"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────────────────────────────────────
# SERVER CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# CORS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:5173"

# ─────────────────────────────────────────────────────────────────────────────
# BCRYPT
# ─────────────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
