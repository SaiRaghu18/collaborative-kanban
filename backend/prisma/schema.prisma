// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum MembershipRole {
  ORG_ADMIN
  TENANT_ADMIN
  MEMBER
}

enum MembershipScope {
  ORGANIZATION
  TENANT
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION
// Top-level entity. A company or group that owns multiple tenants/workspaces.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenants     Tenant[]
  memberships Membership[]
}

// ─────────────────────────────────────────────────────────────────────────────
// TENANT
// A workspace/branch inside an Organization (e.g., "Engineering Team", "Sales").
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  boards       Board[]
  tasks        Task[]
  activityLogs ActivityLog[]

  // Slug is unique per organization
  @@unique([organizationId, slug])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// Application user. Password hash is stored but NEVER returned via API.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String   // NEVER expose this in API responses
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  memberships     Membership[]
  assignedTasks   Task[]        @relation("AssignedTasks")
  createdTasks    Task[]        @relation("CreatedTasks")
  activityLogs    ActivityLog[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MEMBERSHIP
// Unified join table that handles both Org-level and Tenant-level memberships.
// A user with ORG_ADMIN on an organization implicitly has access to all its tenants.
// Tenant-level memberships require an explicit tenantId.
// ─────────────────────────────────────────────────────────────────────────────

model Membership {
  id             String          @id @default(uuid())
  userId         String
  organizationId String
  tenantId       String?         // null => org-level membership
  role           MembershipRole
  scope          MembershipScope
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // A user can only have one membership record per scope target
  @@unique([userId, organizationId, tenantId])
  @@index([userId])
  @@index([organizationId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// BOARD
// A Kanban board belonging to a Tenant.
// version field is used for optimistic concurrency control.
// ─────────────────────────────────────────────────────────────────────────────

model Board {
  id          String   @id @default(uuid())
  name        String
  description String?
  tenantId    String
  createdById String?
  isArchived  Boolean  @default(false)
  version     Int      @default(0) // optimistic concurrency
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  columns Column[]

  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// COLUMN
// A list/column inside a Board (e.g., "To Do", "In Progress", "Done").
// sortOrder uses a float/integer for efficient reordering without bulk updates.
// ─────────────────────────────────────────────────────────────────────────────

model Column {
  id        String   @id @default(uuid())
  title     String
  boardId   String
  sortOrder Float    @default(0) // allows fractional insertion for cheap reorder
  version   Int      @default(0) // optimistic concurrency
  color     String?  // optional color coding
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// TASK
// A card/task inside a Column. Must belong to a Tenant (for security isolation).
// ─────────────────────────────────────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  columnId    String
  tenantId    String       // denormalized for security — always verify this matches the column's board's tenant
  assigneeId  String?
  createdById String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  sortOrder   Float        @default(0) // same fractional ordering strategy
  version     Int          @default(0) // optimistic concurrency
  tags        String[]     @default([])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?  @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User?  @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([columnId, sortOrder])
  @@index([tenantId])
  @@index([assigneeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACTIVITY LOG
// Audit trail of user actions within a Tenant context.
// ─────────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String
  action     String   // e.g. "task.created", "board.renamed", "member.added"
  entityType String   // e.g. "Task", "Board", "Column"
  entityId   String
  metadata   Json?    // flexible payload (before/after values, etc.)
  createdAt  DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorId])
}
