# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────

# In local development (Vite dev server handles proxying to localhost:4000):
# Leave blank or use http://localhost:4000
VITE_API_URL="http://localhost:4000"
VITE_WS_URL="http://localhost:4000"

# In production (e.g. deployed on Vercel), set these in Vercel Project Settings:
# VITE_API_URL="https://your-backend.onrender.com"
# VITE_WS_URL="https://your-backend.onrender.com"
